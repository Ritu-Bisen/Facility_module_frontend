<?xml version="1.0" encoding="utf-8"?>
<!-- 
  ===================================================================
  IIS 10.0 PRODUCTION CONFIGURATION FOR REACT SPA (/ReactFac)
  ===================================================================
  Prerequisites:
  - IIS 10.0 on Windows Server 2016 / 2019 / 2022 / Windows 10/11
  - IIS URL Rewrite Module 2.0+ installed
  ===================================================================
-->
<configuration>
  <system.webServer>

    <!-- 
      ===================================================================
      URL REWRITE RULES (IIS URL Rewrite Module 2.0+)
      ===================================================================
    -->
    <rewrite>
      <rules>
        <!-- 
          Rule 1: Block Dangerous HTTP Verbs (TRACE, TRACK, DEBUG)
          Intercepts disallowed HTTP methods and returns HTTP 405 Method Not Allowed.
        -->
        <rule name="Block Disallowed Verbs" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_METHOD}" pattern="^(TRACE|TRACK|DEBUG)$" />
          </conditions>
          <action type="CustomResponse" statusCode="405" statusReason="Method Not Allowed" statusDescription="HTTP method is disallowed." />
        </rule>

        <!-- 
          Rule 2: React SPA Client-Side Routing (React Router)
          Rewrites all non-file, non-directory requests to /ReactFac/index.html.
          Excludes API endpoint routes matching /api or /FacNodeAPI.
        -->
        <rule name="React SPA Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|FacNodeAPI)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/ReactFac/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 
      ===================================================================
      STATIC CONTENT & MIME TYPES
      Includes <remove> before <mimeMap> to prevent IIS HTTP 500.19 
      duplicate collection entry errors if types exist at machine level.
      ===================================================================
    -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- 
      ===================================================================
      SECURITY & REQUEST FILTERING
      removeServerHeader="true" removes the IIS Server header (IIS 10+).
      Note: Disallowed verbs are handled by URL Rewrite to ensure 
      HTTP 405 is returned instead of IIS RequestFiltering 404.6/403 errors.
      ===================================================================
    -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!-- 
      ===================================================================
      HTTP PROTOCOL - SECURITY HEADERS & DISCLOSURE MITIGATION
      ===================================================================
    -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove Technology & Method Disclosure Headers -->
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="Server" />
        <remove name="Allow" />
        <remove name="Public" />

        <!-- Frame Protection (Clickjacking Mitigation) -->
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />

        <!-- MIME Sniffing Protection -->
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- HSTS (HTTP Strict Transport Security) -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />

        <!-- Referrer Policy -->
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Content Security Policy (CSP) -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://dpdmis.in http://localhost:* ws: wss:; frame-ancestors 'none';" />
      </customHeaders>
    </httpProtocol>

    <!-- 
      ===================================================================
      HTTP ERROR HANDLING
      existingResponse="PassThrough" ensures IIS passes through custom 
      responses generated by modules (such as URL Rewrite's 405 Method Not Allowed)
      without replacing them with IIS default error pages or throwing HTTP 500 errors.
      ===================================================================
    -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>

  <!-- 
    ===================================================================
    ASP.NET SYSTEM.WEB CONFIGURATION
    Disables ASP.NET version header disclosure.
    ===================================================================
  -->
  <system.web>
    <httpRuntime enableVersionHeader="false" />
  </system.web>

</configuration>
