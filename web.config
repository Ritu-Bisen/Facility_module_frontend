<?xml version="1.0" encoding="utf-8"?>
<!-- 
  ===================================================================
  IIS 10.0 CONFIGURATION FOR REACT FRONTEND SINGLE PAGE APPLICATION
  Path: /ReactFac/
  ===================================================================
  Prerequisites on IIS 10.0:
  1. IIS URL Rewrite Module 2.0+ installed
  ===================================================================
-->
<configuration>
  <system.webServer>

    <!-- SPA Client-Side Routing (React Router) -->
    <rewrite>
      <rules>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Do not rewrite if request matches a physical static file or directory -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Bypass rewrite for API requests -->
            <add input="{REQUEST_URI}" pattern="^/(api|FacNodeAPI)" negate="true" />
          </conditions>
          <!-- Rewrites all SPA page requests to index.html -->
          <action type="Rewrite" url="/ReactFac/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Static Content & MIME Types (Safely removes existing extension to avoid IIS 500.19 errors) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <security>
      <!-- Hide IIS server header disclosure on IIS 10+ & Block dangerous HTTP methods (CWE-200 / Vulnerability Point 21) -->
      <requestFiltering removeServerHeader="true">
        <verbs allowUnlisted="true">
          <add verb="TRACE" allowed="false" />
          <add verb="TRACK" allowed="false" />
          <add verb="DEBUG" allowed="false" />
        </verbs>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- Remove ASP.NET / IIS technology disclosure headers (CWE-200 / Vulnerability Point 11, 14 & 21) -->
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="Server" />
        <remove name="Allow" />
        <remove name="Public" />
        
        <!-- Fix Clickjacking: X-Frame-Options (CWE-1021 / Vulnerability Point 2) -->
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        
        <!-- Comprehensive Content Security Policy (CWE-693 / Vulnerability Point 8) -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://dpdmis.in http://localhost:* ws: wss:; frame-ancestors 'none';" />

        <!-- MIME Sniffing Protection (CWE-693 / Vulnerability Point 9) -->
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- HSTS Enforce 1-Year Max Age with includeSubDomains & preload (CWE-693 / Vulnerability Point 17) -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000;" />

        <!-- Referrer Policy -->
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Custom Errors: Prevent detailed IIS error messages and stack traces (CWE-209 / Vulnerability Point 18) -->
    <httpErrors errorMode="Custom" existingResponse="Replace" defaultResponseMode="ExecuteURL" defaultPath="/ReactFac/index.html">
      <remove statusCode="400" />
      <remove statusCode="403" />
      <remove statusCode="404" />
      <remove statusCode="500" />
      <error statusCode="400" path="/ReactFac/index.html" responseMode="ExecuteURL" />
      <error statusCode="403" path="/ReactFac/index.html" responseMode="ExecuteURL" />
      <error statusCode="404" path="/ReactFac/index.html" responseMode="ExecuteURL" />
      <error statusCode="500" path="/ReactFac/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

  <system.web>
    <!-- Prevent ASP.NET stack trace yellow exception screens (CWE-209 / Vulnerability Point 18) -->
    <customErrors mode="On" defaultRedirect="/ReactFac/index.html" redirectMode="ResponseRewrite">
      <error statusCode="400" redirect="/ReactFac/index.html" />
      <error statusCode="403" redirect="/ReactFac/index.html" />
      <error statusCode="404" redirect="/ReactFac/index.html" />
      <error statusCode="500" redirect="/ReactFac/index.html" />
    </customErrors>
    <!-- Disable ASP.NET version header disclosure & sanitize invalid path errors -->
    <httpRuntime enableVersionHeader="false" requestValidationMode="2.0" />
  </system.web>
</configuration>
